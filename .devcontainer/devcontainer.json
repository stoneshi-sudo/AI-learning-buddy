{
  "name": "AI Learning Buddy - 七年级代数学习工具",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:18",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "forwardPorts": [3001, 5173],
  "portsAttributes": {
    "3001": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm run install:all && mkdir -p backend/data && chmod +x start-app.sh .devcontainer/auto-start.sh .devcontainer/welcome.sh",
  "postStartCommand": "bash .devcontainer/welcome.sh && bash .devcontainer/auto-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
